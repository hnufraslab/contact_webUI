<?xml version="1.0"?>
<launch>
    <!-- 点云处理工具启动文件 -->

    <!-- 参数配置 -->
    <arg name="input_topic" default="/cloud_registered" />
    <arg name="output_topic" default="/cloud_in" />
    <arg name="pose_input_topic" default="/mavros/local_position/pose" />
    <arg name="pose_output_topic" default="/mavros/local_position/web_pose" />
    <arg name="output_frame_id" default="web_frame" />
    <arg name="roi_topic" default="/planning/roi_box" />
    <arg name="max_points" default="1500000" />
    <arg name="publish_rate" default="5.0" />

    <!-- 启动点云处理节点 -->
    <node pkg="contact_webui" type="pointcloud_processor.py" name="pointcloud_processor" output="screen">
        <param name="input_topic" value="$(arg input_topic)" />
        <param name="output_topic" value="$(arg output_topic)" />
        <param name="roi_topic" value="$(arg roi_topic)" />
        <param name="max_points" value="$(arg max_points)" />
        <param name="publish_rate" value="$(arg publish_rate)" />
    </node>

    <node pkg="contact_webui" type="pose_to_web_frame.py" name="pose_to_web_frame" output="screen">
        <param name="input_topic" value="$(arg pose_input_topic)" />
        <param name="output_topic" value="$(arg pose_output_topic)" />
        <param name="output_frame_id" value="$(arg output_frame_id)" />
    </node>

</launch>
